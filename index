            <hr>
        </section>

        <!-- CHECKOUT FORM -->
        <section id="checkout">
            <h2>Checkout</h2>
            <p>Enter your details to complete your sample order.</p>

            <form action="#" method="post">

                <fieldset>
                    <legend>Shipping Details</legend>

                    <p>
                        <label for="fullname">Full Name:</label>
                        <input type="text" id="fullname" name="fullname"
                               required>
                    </p>

                    <p>
                        <label for="email">Email Address:</label>
                        <input type="email" id="email" name="email"
                               placeholder="you@example.com" required>
                    </p>

                    <p>
                        <label for="phone">Phone Number:</label>
                        <input type="tel" id="phone" name="phone"
                               placeholder="09XXXXXXXXX">
                    </p>

                    <p>
                        <label for="address">Complete Address:</label><br>
                        <textarea id="address" name="address"
                                  rows="4" cols="40" required></textarea>
                    </p>

                    <p>
                        <label for="city">City:</label>
                        <input type="text" id="city" name="city"
                               list="cities" required>

                        <datalist id="cities">
                            <option value="Baguio City">
                            <option value="Quezon City">
                            <option value="Manila">
                            <option value="Cebu City">
                            <option value="Davao City">
                        </datalist>
                    </p>

                    <p>
                        <label for="delivery-date">Delivery Date:</label>
                        <input type="date" id="delivery-date"
                               name="delivery-date">
                    </p>

                    <p>
                        <label for="delivery-option">Delivery Option:</label>
                        <select id="delivery-option" name="delivery-option">
                            <option value="standard">Standard Delivery</option>
                            <option value="express">Express Delivery</option>
                            <option value="pickup">Store Pick-up</option>
                        </select>
                    </p>
                </fieldset>

                <br>

                <fieldset>
                    <legend>Payment Method</legend>

                    <p>
                        <input type="radio" id="card" name="payment"
                               value="card" checked>
                        <label for="card">Credit / Debit Card</label>
                    </p>

                    <p>
                        <input type="radio" id="cod" name="payment"
                               value="cod">
                        <label for="cod">Cash on Delivery</label>
                    </p>

                    <p>
                        <input type="radio" id="ewallet" name="payment"
                               value="ewallet">
                        <label for="ewallet">E-Wallet</label>
                    </p>
                </fieldset>

                <p>Additional Options:</p>

                <p>
                    <input type="checkbox" id="gift-wrap"
                           name="extras" value="gift-wrap">
                    <label for="gift-wrap">Gift Wrap</label>
                </p>

                <p>
                    <input type="checkbox" id="receipt"
                           name="extras" value="receipt">
                    <label for="receipt">Include Receipt</label>
                </p>

                <p>
                    <input type="checkbox" id="terms-agree"
                           name="terms-agree" value="yes" required>
                    <label for="terms-agree">
                        I agree to the
                        <a href="#terms-info">Terms &amp; Conditions</a>
                    </label>
                </p>

                <button type="submit">Place Order</button>
                <button type="reset">Clear</button>
            </form>
            <hr>
        </section>

