            <h3>Leave a Review</h3>

            <form action="#" method="post"
                  enctype="multipart/form-data">

                <p>
                    <label for="review-name">Your Name:</label>
                    <input type="text" id="review-name"
                           name="review-name" required>
                </p>

                <p>
                    <label for="rating">Rating (1 to 5):</label>
                    <input type="range" id="rating" name="rating"
                           min="1" max="5" value="5">
                </p>

                <p>
                    <label for="review-message">Your Review:</label><br>
                    <textarea id="review-message" name="review-message"
                              rows="5" cols="40" required></textarea>
                </p>

                <p>
                    <label for="review-photo">Upload a Photo (Optional):</label>
                    <input type="file" id="review-photo"
                           name="review-photo" accept="image/*">
                </p>

                <button type="submit">Submit Review</button>
            </form>
            <hr>
        </section>

