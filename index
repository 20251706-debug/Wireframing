                <tr>
                    <td>
                        <h3>👕 Sports Shirt</h3>
                        <p>A comfortable shirt for active days.</p>
                        <p>Price: <strong>₱350.00</strong></p>

                        <label for="shirt-size">Choose Size:</label>
                        <select id="shirt-size" name="shirt-size">
                            <option value="S">Small (S)</option>
                            <option value="M">Medium (M)</option>
                            <option value="L">Large (L)</option>
                            <option value="XL">Extra Large (XL)</option>
                        </select>
                        <p><button type="button">Add to Cart</button></p>
                    </td>
                    <td>
                        <h3>👖 Jogging Pants</h3>
                        <p>Comfortable pants for walking or exercise.</p>
                        <p>Price: <strong>₱500.00</strong></p>

                        <label for="pants-size">Choose Size:</label>
                        <select id="pants-size" name="pants-size">
                            <option value="S">Small (S)</option>
                            <option value="M">Medium (M)</option>
                            <option value="L">Large (L)</option>
                            <option value="XL">Extra Large (XL)</option>
                        </select>
                        <p><button type="button">Add to Cart</button></p>
                    </td>
                    <td>
