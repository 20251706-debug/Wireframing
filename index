        <!-- SHOPPING CART -->
        <section id="cart">
            <h2>Your Cart</h2>
            <p>Sample items are shown below for demonstration.</p>

            <table border="1" cellpadding="8" cellspacing="0">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Qty</th>
                        <th>Subtotal</th>
                        <th>Remove</th>
                    </tr>
                </thead>

                <tbody>
                    <tr>
                        <td>Fresh Apples</td>
                        <td>₱120.00</td>
                        <td>
                            <input type="number" name="apple-qty"
                                   min="1" max="20" value="1">
                        </td>
                        <td>₱120.00</td>
                        <td>
                            <button type="button">Remove</button>
                        </td>
                    </tr>

                    <tr>
                        <td>Water Bottle</td>
                        <td>₱180.00</td>
                        <td>
                            <input type="number" name="bottle-qty"
                                   min="1" max="20" value="1">
                        </td>
                        <td>₱180.00</td>
                        <td>
                            <button type="button">Remove</button>
                        </td>
                    </tr>
                </tbody>

                <tfoot>
                    <tr>
                        <td colspan="3"><strong>Total</strong></td>
                        <td colspan="2"><strong>₱300.00</strong></td>
                    </tr>
                </tfoot>
